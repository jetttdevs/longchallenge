<%- include('partials/header', { title: 'Sign in' }) %>
<div style="max-width:440px;margin:60px auto;">
  <div class="card" style="text-align:center;padding:36px 28px;">
    <img src="/img/logo.svg" alt="Long Challenge" style="width:64px;height:64px;margin-bottom:14px;" />
    <h2 style="margin:0 0 8px;">Sign in to Long Challenge</h2>
    <p class="muted" style="margin:0 0 24px;">New accounts get a 50 <%= CURRENCY.symbol %> welcome credit.</p>
    <% if (error) { %><div class="flash error"><%= error %></div><% } %>
    <% if (xConfigured) { %>
      <a class="btn" style="width:100%;display:block;" href="/auth/x/login">Sign in with X</a>
      <p class="muted" style="margin-top:16px;font-size:12px;">We only use your X profile (username &amp; avatar) to identify you \u2014 no posting, no DMs, no wallet access.</p>
    <% } else { %>
      <div class="flash error">X login isn't configured on this deployment yet (missing X_CLIENT_ID / X_CLIENT_SECRET / BASE_URL).</div>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
