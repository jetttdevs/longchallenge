<%- include('partials/header', { title: 'Challenges' }) %>

<section class="hero">
  <img class="logo-big" src="/img/logo.svg" alt="Long Challenge" />
  <h1>Set the challenge. <span>Pay in <%= CURRENCY.symbol %>.</span> Get it done.</h1>
  <p>
    Post a challenge — "create a video about X", "write content for Y", anything — back it with
    Long Challenge Tokens, and let the community submit their best work. Every challenge and every
    submission is reviewed before it goes live or gets paid out.
  </p>
  <% if (!user) { %>
  <div class="cta">
    <a class="btn" href="/register">Get started</a>
    <a class="btn secondary" href="/login">Log in</a>
  </div>
  <% } else { %>
  <div class="cta">
    <a class="btn" href="/challenges/new">Create a Challenge</a>
  </div>
  <% } %>
</section>

<div class="section-title">
  <h2>Open Challenges</h2>
</div>
<div class="filters">
  <a href="/" class="btn small <%= activeCategory === '' ? '' : 'secondary' %>">All</a>
  <% CATEGORIES.forEach(function(c){ %>
    <a href="/?category=<%= c.id %>" class="btn small <%= activeCategory === c.id ? '' : 'secondary' %>"><%= c.label %></a>
  <% }) %>
</div>

<% if (challenges.length === 0) { %>
  <div class="card muted">No open challenges yet<%= activeCategory ? ' in this category' : '' %>. Be the first to <a href="/challenges/new">create one</a>.</div>
<% } else { %>
<div class="grid">
  <% challenges.forEach(function(c){ %>
    <a class="card challenge-card" href="/challenges/<%= c.id %>" style="color:inherit;text-decoration:none;">
      <span class="cat"><%= CATEGORIES.find(x=>x.id===c.category) ? CATEGORIES.find(x=>x.id===c.category).label : c.category %></span>
      <h3><%= c.title %></h3>
      <p><%= c.description.length > 120 ? c.description.slice(0,120) + '…' : c.description %></p>
      <div class="meta">
        <span class="reward"><%= c.reward_tokens %> <%= CURRENCY.symbol %></span>
        <span class="muted"><%= c.submission_count %> submission<%= c.submission_count === 1 ? '' : 's' %></span>
      </div>
      <div class="meta">
        <span class="muted">by <%= c.creator_name %></span>
        <span class="muted"><%= c.deadline ? ('due ' + c.deadline) : 'no deadline' %></span>
      </div>
    </a>
  <% }) %>
</div>
<% } %>

<%- include('partials/footer') %>
