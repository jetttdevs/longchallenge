# Copy to .env (or set as real environment variables) before starting the server.

PORT=3210

# Public base URL this deployment is reachable at (no trailing slash).
# Must exactly match the callback URL registered in your X (Twitter) Developer App.
BASE_URL=https://your-domain-or-tunnel-url

# X (Twitter) "Sign in with X" credentials — create an app at https://developer.x.com
# Using OAuth 1.0a here (the "API Key and Secret" pair, NOT the OAuth 2.0 Client
# ID/Secret) as a workaround while X's OAuth 2.0 authorize endpoint has a known
# platform-side bug. Callback URL registered in the portal must still be
# ${BASE_URL}/auth/x/callback.
X_API_KEY=
X_API_SECRET=

# X username (no @) that should automatically become the site admin on first login.
ADMIN_X_USERNAME=
